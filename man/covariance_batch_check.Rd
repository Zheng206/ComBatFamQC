\deqn{d_{\mathrm{RMS}} = \sqrt{\frac{\sum_{i \ne j}\Delta_{ij}^2}{p(p-1)}}}
\deqn{d_{\max} = \max_{i,j}|\Delta_{ij}|}
\deqn{d_2 = \|\Delta\|_2 = \sigma_{\max}(\Delta) = \max_k|\lambda_k(\Delta)|}
\deqn{d_F = \|\Delta\|_F = \sqrt{\sum_{i=1}^{p}\sum_{j=1}^{p}\Delta_{ij}^2}}
